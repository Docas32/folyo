# Dev: lvh.me | produção: domínio raiz adquirido (sem protocolo/porta).
ROOT_DOMAIN=lvh.me
# dev | preview | prod. O health-check R2 e proxy localhost só existem em dev.
ENVIRONMENT=dev
# Neon: copie a URL pooled do painel Connect, com sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Auth.js v5: Google OAuth Web application credentials.
AUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# R2 S3 API (uploads + leitura pública + limpeza de assets). Bucket: folyo-assets.
# Mesmas credenciais em dev/Workers; secrets de servidor, nunca NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
