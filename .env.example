# Dev: lvh.me | produção: domínio raiz adquirido (sem protocolo/porta).
ROOT_DOMAIN=lvh.me
# dev | preview | prod. O health-check R2 e proxy localhost só existem em dev.
ENVIRONMENT=dev
# Neon: copie a URL pooled do painel Connect, com sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# F2 adicionará GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, AUTH_SECRET.
